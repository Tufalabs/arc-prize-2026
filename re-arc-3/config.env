# ARC-AGI runner config (KEY=VALUE, no `export`)
#
# Required: pick the game you want to run/play.
# GAME_ID should match a valid ARC-AGI game id for your setup.
# Tip: run `make games` to list discovered game ids.
# GAME_ID options: ls20, vc33, ft09, js26, ct01-v1, ct03-v1, gw01-v1, gw02-v1, maze-0001, push-0001, taps-0001, swch-0001, keys-0001, flux-0001, orbx-0001, rail-0001, turn-0001, blink-0001, pbox-0001, glyph-0001, drft-0001, fuse-0001, weav-0001, beam-0001, grav-0001, sent-0001, rows-0001, chan-0001, rook-0001, sync-0001, dial-0001, warp-0001, paint-0001
GAME_ID=escape_velocity-0001
WEB_PORT=8000
#
# Optional engine settings
OPERATION_MODE=OFFLINE    # NORMAL (local+API), ONLINE (API only), OFFLINE (local only)
# ARC_API_KEY=
# ARC_BASE_URL=
ENVIRONMENTS_DIR=re_arc/environment_files  # Folder containing `**/metadata.json` for offline/local discovery
# RECORDINGS_DIR=
#
# Optional dataset sampling. Use with GAME_ID=random to sample only from saved dataset files.
# DATASETS_DIR=/path/to/custom/datasets
# DATASET=train
# EXCLUDE_DATASET=heldout
#
# Optional runtime settings
# MAX_ACTIONS=400
SEED=None
AUGMENT=false    # Enables sampler augmentation when set to true. Works with GAME_ID=random and local packaged games.
# Optional selective augmentation switches. Only used when AUGMENT=true.
AUGMENT_COLOR_PERMUTATION=false
AUGMENT_ROTATION=true
AUGMENT_FLIP_LR=true
#
# Optional web UI settings
# WEB_HOST=127.0.0.1

#
# Optional GIF recording (works with both policies)
# GIF_PATH=runs/latest.gif
FPS=4
# SCALE=6
# SEPARATOR=2
