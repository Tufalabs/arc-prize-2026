# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Scratch-backed side-by-side environments used for runtime experiments
.venv.*

# Local secrets (API keys) — never commit
.env
.env.*

.vscode/
slurm*
.nfs*
*.out
.DS_Store

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated outputs
notebooks/*.gif
notebooks/*.mp4
notebooks/runs/
*.pkl

# Per-column GPU test logs (written by `make test-gpu-srun`)
.gpu-test-logs/
demo_runs/
# Local investigation notes and run reports, separate from repository docs
/docs/

# Ad-hoc run/driver logs (nohup harness output etc.) — never commit
*.log
